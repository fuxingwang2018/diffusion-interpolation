Bootstrap: docker
From: pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime



%files
    ./requirements.txt /requirements.txt
    

#TODO: needs more work
%post
    set -e

    mkdir -p /work

    echo "Upgrading pip and installing Python dependencies..."

    python3 -m pip install --upgrade pip setuptools wheel

    # Check if requirements.txt is provided and install packages
    if [ -f /requirements.txt ]; then
        echo "Installing Python packages from requirements.txt..."
        python3 -m pip install --no-cache-dir -r /requirements.txt
        cd /work
        python3 -m pip install --no-cache-dir .
    else
        echo "No requirements.txt file found. Skipping Python package installation."
    fi

%environment
    export PATH=/usr/local/bin:$PATH
    export PYTHONUNBUFFERED=1

%runscript
    echo "Starting the Python environment..."
    python3 --version
    echo "Testing ion Model
    

%labels
    Author Daniel Yazgi
    Version 1.0
    Description "Python environment with dependencies."



